{
  "name": "crystal-studio",
  "version": "0.1.0-beta.2",
  "description": "Crystal structure renders and looping movies, online and on your desktop.",
  "author": "M. J. Sowden",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sowden94/Crystal-Studio.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "check": "node scripts/check.mjs",
    "build:web": "node scripts/build-web.mjs",
    "desktop:mac": "electron-builder --mac dmg zip --publish never",
    "desktop:windows": "electron-builder --win nsis zip --x64 --publish never",
    "desktop:linux": "electron-builder --linux dir --publish never",
    "package:preview": "electron-builder --dir --publish never",
    "security:check": "node scripts/check-security.mjs",
    "security:audit": "node scripts/audit-security.mjs",
    "security:fuzz": "node scripts/fuzz-imports.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.sowden.crystalstudio",
    "productName": "Crystal Studio",
    "copyright": "Copyright \u00a9 2026 M. J. Sowden",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "web/**",
      "examples/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "third-party-licenses/**",
      "build/icon.png"
    ],
    "asar": true,
    "artifactName": "Crystal-Studio-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "LICENSE",
      "artifactName": "Crystal-Studio-${version}-windows-${arch}-setup.exe"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "crystalstudio",
        "name": "Crystal Studio project",
        "description": "Crystal structure and saved view",
        "role": "Editor"
      }
    ],
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
